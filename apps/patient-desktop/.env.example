# Settings for this patient device. Copy it and edit your copy:
#   cp apps/patient-desktop/.env.example apps/patient-desktop/.env
# .env is gitignored - never commit it. A real environment variable overrides the .env file.

# --- Supabase (Project Settings -> API Keys) ---
# Demo mode, no sign-in: the app uses the PUBLISHABLE key (sb_publishable_...) only.
# NEVER put the secret key here. The app plays the first patient in the database that has a bed,
# and sends requests to the patient_requests table through the database function
# submit_patient_request (server/supabase/migrations/20261108020000_patient_requests.sql).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
