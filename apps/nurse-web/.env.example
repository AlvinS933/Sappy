# Copy to apps/nurse-web/.env (gitignored). In production, set these in the Vercel project.
# Vite only exposes variables prefixed with VITE_, and only reads .env files from this folder.
# Use the publishable key (sb_publishable_...) - NEVER the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
