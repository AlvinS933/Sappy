{
  "name": "patient-care-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter nurse-web --filter patient-desktop dev",
    "dev:nurse": "pnpm --filter nurse-web dev",
    "dev:patient": "pnpm --filter patient-desktop dev",
    "build": "pnpm -r build",
    "build:nurse": "pnpm --filter nurse-web build",
    "build:patient": "pnpm --filter patient-desktop build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "ai:setup": "node scripts/ai-setup.mjs",
    "data:synthea": "python3 server/Synthea_Gen/synthea.py",
    "data:transform": "python3 server/Synthea_Gen/transform.py",
    "sim:demo": "python3 server/sim/cli.py demo",
    "sim:serve": "python3 server/sim/cli.py serve --demo",
    "test:sim": "python3 -m unittest discover server/sim -v && python3 -m unittest discover server/Synthea_Gen -v",
    "alerts": "python3 server/news2/alert_worker.py",
    "test:alerts": "python3 -m unittest server/news2/test_alert_worker.py -v",
    "wake:test": "node scripts/wake-test.mjs"
  }
}
