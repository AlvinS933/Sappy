{
  "name": "patient-care-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter nurse-web --filter patient-desktop dev",
    "dev:nurse": "pnpm --filter nurse-web dev",
    "dev:patient": "pnpm --filter patient-desktop dev",
    "build": "pnpm -r build",
    "build:nurse": "pnpm --filter nurse-web build",
    "build:patient": "pnpm --filter patient-desktop build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "data:synthea": "python3 Synthea_Gen/synthea.py",
    "sim:demo": "python3 sim/cli.py demo",
    "sim:serve": "python3 sim/cli.py serve --demo",
    "test:sim": "python3 -m unittest discover sim -v && python3 -m unittest discover Synthea_Gen -v",
    "data:transform": "python3 Synthea_Gen/transform.py"
  }
}
